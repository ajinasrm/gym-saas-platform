# ---------------------------------------------------------------------------
# CLIENT-SIDE (bundled into the browser build — never put secrets here)
# In Vercel: Project -> Settings -> Environment Variables
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=""

# Supabase ANON / publishable key. Safe to expose: it is restricted by the RLS
# policies in supabase_schema.sql. Do NOT use the service_role key here.
VITE_SUPABASE_ANON_KEY=""

# Domain appended when someone signs in with a bare username.
# "ajinas0496" -> ajinas0496@gmail.com
# Must match the domain of public.admin_email() in supabase_schema.sql.
VITE_LOGIN_DOMAIN="gmail.com"


# ---------------------------------------------------------------------------
# SERVER-SIDE (used by /api functions only — never prefixed with VITE_)
# ---------------------------------------------------------------------------

# Google Gemini API key for the AI workout generator and gym insights.
# Without it those endpoints return their built-in fallback content.
GEMINI_API_KEY=""

# Same project URL as above, for the server-side client.
SUPABASE_URL=""

# SECRET. Bypasses row-level security. Server only — never expose to the
# browser and never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""

# Vercel sets this automatically when you add a cron job; the cron endpoint
# rejects requests without it. Set it manually for local testing.
CRON_SECRET=""

# Razorpay — the payment endpoints are SIMULATED stubs. Setting this alone
# does not make payments real; see README "Payments are not live".
RAZORPAY_KEY_ID=""
